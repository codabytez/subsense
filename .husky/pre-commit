echo '🏗️👷 Running checks on your code before committing 🔍🧐'

STAGED_FILES=$(git diff --cached --name-only -z)

echo '🎨✨ Checking formatting...'
pnpm run check-format ||
(
    echo '🤢🤮 Your formatting is off. Running Prettier...'
    pnpm run format
    if [ -n "$STAGED_FILES" ]; then
        printf '%s' "$STAGED_FILES" | xargs -0 git add --
    fi
    echo '✨ Formatting fixed and re-staged (only the files that were already staged).'
)

echo '🔍 Running lint-staged...'
pnpm exec lint-staged ||
(
    echo '😤 ESLint or type errors found. Fix the issues above and try again.'
    false
)

echo '✅ All checks passed! Committing...'
